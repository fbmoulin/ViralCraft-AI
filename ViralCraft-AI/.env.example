# ViralCraft-AI Environment Configuration

# ─── Server ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# CSV of allowed CORS origins. Required in production; leave blank to deny all.
# Example: CORS_ORIGIN=https://app.viralcraft.ai,https://www.viralcraft.ai
CORS_ORIGIN=*

# ─── Database ───────────────────────────────────────────────────────────
# SQLite (development default):
# DATABASE_URL=sqlite:./soulclap.db
# PostgreSQL via Neon (recommended for production):
# DATABASE_URL=postgresql://user:password@ep-XXXXX.region.aws.neon.tech/dbname?sslmode=require
# Set DB_SSL_STRICT=false only for self-signed certs in a private network.
DB_SSL_STRICT=true

# ─── AI ─────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# YOUTUBE_API_KEY=...
DEMO_MODE=true

# ─── Rate limiting (per IP, per minute) ─────────────────────────────────
AI_RATE_LIMIT_PER_MIN=20
READ_RATE_LIMIT_PER_MIN=100

# ─── Debug / Admin endpoints ────────────────────────────────────────────
# Required in production to access /api/debug, /api/test-ai, /api/clear-logs, /api/reinit-ai.
# Generate with: openssl rand -hex 32
# DEBUG_TOKEN=

# ─── Observability (Sprint 3) ───────────────────────────────────────────
# SENTRY_DSN=
# REDIS_URL=redis://localhost:6379

# ─── Authentication (Sprint 4 — Clerk) ──────────────────────────────────
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# CLERK_WEBHOOK_SECRET=whsec_...

# ─── Billing (Sprint 5 — Stripe) ────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...

# ─── Logging ────────────────────────────────────────────────────────────
LOG_LEVEL=info
